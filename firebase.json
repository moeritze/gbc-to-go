{
  "hosting": {
    "public": "web",
    "ignore": ["**/*.gb", "**/*.gbc", "**/*.sav", "**/*.test.mjs", "**/*.example.js", "**/.*"],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }] },
      { "source": "**/*.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] },
      { "source": "**/*.@(js|json|html|css|wasm)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": ".build/firestore.rules", "indexes": "firestore.indexes.json" }
}
